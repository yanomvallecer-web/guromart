# Copy to .env.local for development. Never commit real keys.
# In production set these in your host's environment settings (e.g. Vercel project settings).

# Public URL of the site, used in sign-in email links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project settings > API). For local development,
# `npx supabase start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row-level security. Used by payment webhooks,
# signed downloads and admin scripts. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# PayMongo (test mode only for now). Secret key from Developers > API keys;
# webhook secret from the webhook you create for /api/webhooks/paymongo.
# Leave empty to keep checkout closed. Live keys (sk_live_) are refused.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional: payment methods shown on PayMongo's page (default gcash,paymaya,card).
# Defaults to qrph (individual PayMongo accounts). A registered business can use e.g. qrph,gcash,paymaya,card
# PAYMONGO_PAYMENT_METHODS=qrph

# Set to true after enabling each provider in Supabase Auth > Sign In / Providers.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_FACEBOOK_ENABLED=false

# Database tests (plain PostgreSQL, never a Supabase project).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
