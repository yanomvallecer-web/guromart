# Copy to .env.local for development. Never commit real keys.
# In production set these in your host's environment settings (e.g. Vercel project settings).

# Public URL of the site, used in sign-in email links and OAuth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project settings > API). For local development,
# `npx supabase start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses row-level security. Used by payment webhooks,
# signed downloads and admin scripts. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Set to true after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Database tests (plain PostgreSQL, never a Supabase project).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
